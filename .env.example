# Server configuration from MVP_SPEC_QOR_AI.md, section 10.
# Copy to .env; never commit credentials. No VITE_ / browser credentials.
APP_ENV=development
DATA_MODE=synthetic
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_PATH=./data/qor.sqlite3

# The captain implements the AI adapter. The calculation engine needs no key.
# Select openai or nvidia, then fill the corresponding key and available model ID.
AI_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Use a random session secret; the local setup generates one in .env.
# ADMIN_PASSWORD_HASH must contain a hash supported by the captain's auth code.
SESSION_SECRET=
ADMIN_PASSWORD_HASH=


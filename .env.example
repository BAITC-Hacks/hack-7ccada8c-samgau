# Server configuration from MVP_SPEC_QOR_AI.md, section 10.
# Copy to .env; never commit credentials. No VITE_ / browser credentials.
APP_ENV=development
DATA_MODE=synthetic
PUBLIC_BASE_URL=http://localhost:8000
DATABASE_PATH=./data/qor.sqlite3

# AI adapter is included. The calculation engine needs no key.
# Select openai or nvidia, then fill the corresponding key and available model ID.
AI_PROVIDER=disabled
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-luna
NVIDIA_API_KEY=
NVIDIA_MODEL=
NVIDIA_BASE_URL=

# Reserved by the original team specification; the current API does not use
# SESSION_SECRET or ADMIN_PASSWORD_HASH. It uses automatically created opaque visitor sessions.
SESSION_SECRET=
ADMIN_PASSWORD_HASH=

# Captain API settings. DATABASE_PATH above selects the SQLite file;
# QOR_DATA_DIR selects the uploads directory (and default DB if DATABASE_PATH is blank).
QOR_DATA_DIR=./data
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Generate: python -c "import secrets; print(secrets.token_urlsafe(32))"
# Optional admin-only API mode; never put this token in frontend builds.
ADMIN_TOKEN=
# session (default): each browser session can upload its own files without a key.
# admin: API imports additionally require X-Admin-Token; UI uploads are disabled.
IMPORT_ACCESS=session

# Bundled modules are enabled by default (including blank values in an older .env).
ENGINE_MODULE=app.engine.service
IMPORTER_MODULE=app.importers.service

# Optional common AI settings take precedence over OPENAI_* / NVIDIA_* above.
# Leave blank to use provider-specific settings. OpenAI has a default base URL.
# NVIDIA requires NVIDIA_BASE_URL or AI_BASE_URL for the selected provider.
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=
AI_RESPONSE_FORMAT=json_schema
AI_TIMEOUT_SECONDS=35
# Enable to send the bounded calculation snapshot and chat to the chosen provider.
ALLOW_REAL_AI=false

# Local Caddy: http://localhost:8080. Set an actual DNS name for server HTTPS.
SITE_ADDRESS=:80
HTTP_PORT=8080
HTTPS_PORT=8443
